# Backward-compatible single-host template.  New deployments should start from
# primary.env.example or secondary.env.example so the FreeIPA and DNS roles
# are explicit.  Change the example values and keep the real file mode 0600.
# FreeIPA identity and host parameters. IPA_REALM may be left blank to derive
# the uppercase domain.
IPA_DOMAIN=example.invalid
IPA_REALM=EXAMPLE.INVALID
SERVER_FQDN=ipa01.example.invalid
# Legacy alias, equivalent to SERVER_FQDN:
IPA_HOSTNAME=ipa01.example.invalid
IPA_IP_ADDRESS=192.0.2.10

# FreeIPA server topology.  The first server is the only host that uses
# ipa-server-install.  Every additional server must use IPA_SERVER_ROLE=replica
# and a source FQDN; the script never promotes or converts an existing server.
IPA_SERVER_ROLE=primary
IPA_REPLICA_SOURCE=
IPA_REPLICA_PRINCIPAL=admin
IPA_REPLICA_SETUP_CA=true

# Required secrets.  IPA_DIRECTORY_MANAGER_PASSWORD is needed by a primary
# (and by an explicitly requested KRA); a replica uses the supported privileged
# IPA principal/password method and therefore only needs IPA_ADMIN_PASSWORD.
# Keep the real .env file root-owned, mode 0600, and never commit it.
IPA_DIRECTORY_MANAGER_PASSWORD=
IPA_ADMIN_PASSWORD=

# Use the integrated Dogtag CA by default on a primary.  Set IPA_SETUP_CA=false
# only for a new CA-less primary that will use externally issued LDAP/HTTP
# certificates.  For a replica, use IPA_REPLICA_SETUP_CA=false with the same
# certificate inputs if the target RHEL release supports CA-less replicas.
IPA_SETUP_CA=true
IPA_SETUP_KRA=false

# Optional server-install features.  The same SSH trust/subid flags are passed
# to ipa-replica-install when the installed RHEL version advertises them.
# --ssh-trust-dns makes OpenSSH trust IPA DNS SSHFP records.
# --subid configures SSSD to use IPA as the subordinate-ID data source.
IPA_SSH_TRUST_DNS=false
IPA_SETUP_SUBID=false

# CA-less mode only (IPA_SETUP_CA=false).  Values are whitespace-separated
# absolute file paths; the server and HTTP certificate lists are required.
# IPA_CA_CERT_FILES is optional when both server files contain the full chain.
# PKINIT files are optional; without them the installer creates a local KDC
# certificate.  PIN values are passed only to ipa-server-install and redacted.
IPA_DIRSRV_CERT_FILES=""
IPA_HTTP_CERT_FILES=""
IPA_CA_CERT_FILES=""
IPA_DIRSRV_CERT_PIN=""
IPA_HTTP_CERT_PIN=""
IPA_PKINIT_CERT_FILES=""
IPA_PKINIT_CERT_PIN=""

# Defaults for future FreeIPA user entries; this does not create users.
IPA_DEFAULT_SHELL=/bin/bash
IPA_HOME_ROOT=/home

# Host and local-login behaviour.
CONFIGURE_HOSTNAME=false
MANAGE_HOSTNAME=false
CONFIGURE_SERVER_MKHOMEDIR=false

# Leave empty to retain the existing time configuration.  Multiple values are
# whitespace separated, for example: "192.0.2.11 192.0.2.12"
NTP_SERVERS=""

# Initial attempt plus at most one automatic retry by default.
IPA_INSTALL_MAX_ATTEMPTS=2

# DNS backend selection. Enable exactly ONE DNS_BACKEND line. The legacy
# IPA_DNS_MODE/DNS_PROVIDER pair below remains supported for existing files.
DNS_BACKEND=bind9_webmin
# DNS_BACKEND=integrated
# DNS_BACKEND=technitium
# DNS_BACKEND=existing
IPA_DNS_MODE=external
DNS_PROVIDER=bind9-webmin

# DNS topology is independent from the FreeIPA server role.  The defaults
# describe the common single-server layout.  For a redundant pair, set these
# explicitly on both hosts:
#   primary .env:   DNS_SERVER_ROLE=primary, DNS_PRIMARY_SERVER=ipa01...,
#                   DNS_PRIMARY_IP=192.0.2.10, DNS_SECONDARY_SERVER=ipa02...,
#                   DNS_SECONDARY_IP=192.0.2.11
#   secondary .env: DNS_SERVER_ROLE=secondary, DNS_PRIMARY_SERVER=ipa01...,
#                   DNS_PRIMARY_IP=192.0.2.10, DNS_SECONDARY_SERVER=ipa02...,
#                   DNS_SECONDARY_IP=192.0.2.11
DNS_SERVER_ROLE=primary
DNS_PRIMARY_SERVER=ipa01.example.invalid
DNS_PRIMARY_IP=192.0.2.10
DNS_SECONDARY_SERVER=
DNS_SECONDARY_IP=
# Optional additional DNS nodes for firewall peer rules. Entries use
# fqdn=ipv4 and are whitespace-separated, for example:
# DNS_ADDITIONAL_NODES="ipa02.example.invalid=192.0.2.11 ipa03.example.invalid=192.0.2.12"
DNS_ADDITIONAL_NODES=
# A primary may derive one /24 reverse zone from its own address.  A secondary
# must list every authoritative reverse zone explicitly; this prevents a new
# subnet from being guessed or invented.
DNS_AUTHORITATIVE_REVERSE_ZONES=
# TSIG is preferred whenever a secondary is configured.  The primary generates
# a key if DNS_TRANSFER_KEY_SECRET is empty; copy that protected key file to
# the secondary through an approved secret-distribution process, or set the
# same secret on both hosts before the first configuration.  The secret is
# never logged.  A secondary never edits transferred slave zone files.
DNS_TRANSFER_SECURITY=tsig
DNS_TRANSFER_KEY_NAME=freeipa-bootstrap-transfer
DNS_TRANSFER_KEY_FILE=/etc/named/freeipa-bootstrap-transfer.key
DNS_TRANSFER_KEY_SECRET=
DNS_TSIG_ENABLED=true
DNS_TSIG_KEY_NAME=freeipa-bootstrap-transfer
DNS_TSIG_KEY_FILE=/etc/named/freeipa-bootstrap-transfer.key
DNS_TSIG_PROVISION=manual
DNS_TSIG_SSH_USER=root
DNS_TSIG_SSH_KEY_FILE=
DNS_TSIG_SSH_PORT=22
DNS_NOTIFY_ENABLED=true
DNS_DYNAMIC_UPDATE_MODE=disabled
# BIND secure DDNS uses TSIG update-policy and does not require a source list;
# BIND insecure uses BIND_ALLOW_UPDATE_ACL; Technitium secure/insecure uses
# DNS_DYNAMIC_UPDATE_NETWORKS (or TECHNITIUM_UPDATE_NETWORKS).
DNS_DYNAMIC_UPDATE_NETWORKS=
DNS_TRANSFER_WAIT_SECONDS=90
DNS_TRANSFER_POLL_SECONDS=3
# Multiple values are whitespace separated.  Set DNS_FORWARDERS="" to leave
# forwarding unset (integrated DNS uses --no-forwarders in that case).
DNS_FORWARDERS="192.0.2.53 192.0.2.54"

# BIND recursion is never open to the world.  Add the trusted internal CIDRs
# that should be allowed to recurse when using bind9-webmin.
DNS_RECURSION_NETWORKS="127.0.0.0/8"

# Optional resolver used for existing-DNS validation.  Empty uses the system
# resolver.  It is not used to configure external DNS.
DNS_VALIDATION_SERVER=""

# Provider paths and resource thresholds.
DNS_TTL=86400
DNS_BIND_CONFIG_FILE=/etc/named.conf
DNS_BIND_INCLUDE_FILE=/etc/named/freeipa-bootstrap.conf
DNS_BIND_ZONE_DIR=/var/named/freeipa-bootstrap
DNS_BIND_SLAVE_DIR=/var/named/slaves
BIND_CONFIG_MODE=managed_include
BIND_ZONE_FILE_MODE=custom
BIND_NATIVE_ZONE_CONFIG_FILE=
BIND_NATIVE_ZONE_DIR=/var/named
BIND_ACL_NAME=trusted_networks
BIND_ACL_NETWORKS="127.0.0.0/8"
BIND_ALLOW_QUERY_ACL=
BIND_ALLOW_RECURSION_ACL=
BIND_ALLOW_UPDATE_ACL=
BIND_ALLOW_TRANSFER_ACL=
BIND_ALLOW_NOTIFY_ACL=
BIND_ALLOW_UPDATE_FORWARDING_ACL=

# Technitium API/installer settings. These are used only when
# DNS_BACKEND=technitium; use a token file or a secret manager in production.
TECHNITIUM_API_URL=https://dns01.example.invalid:53443
TECHNITIUM_API_TOKEN=
TECHNITIUM_API_TOKEN_FILE=
TECHNITIUM_API_USERNAME=admin
TECHNITIUM_API_PASSWORD=
TECHNITIUM_API_CA_FILE=
TECHNITIUM_API_TLS_VERIFY=true
TECHNITIUM_INSTALLER_URL=https://download.technitium.com/dns/install.sh
TECHNITIUM_INSTALLER_SHA256=
TECHNITIUM_INSTALL_DIR=/opt/technitium/dns
TECHNITIUM_CONFIG_DIR=/etc/dns
TECHNITIUM_LOG_DIR=/var/log/technitium/dns
TECHNITIUM_SERVICE_NAME=dns.service
TECHNITIUM_ZONE_TRANSFER_PROTOCOL=Tcp
TECHNITIUM_VALIDATE_ZONE=false
TECHNITIUM_UPDATE_NETWORKS=
# Technitium firewall integration is automatic whenever UFW or firewalld is active.
# Optional client networks for source-restricted Technitium DNS firewall rules.
# When empty, DNS 53 follows the existing firewall zone/interface policy.
TECHNITIUM_DNS_CLIENT_NETWORKS=
# Webmin's management listener.  The bootstrap validates this value and, for
# external bind9-webmin mode, opens the matching TCP port in active firewalld.
WEBMIN_PORT=10000
WEBMIN_CONFIG_FILE=/etc/webmin/miniserv.conf
WEBMIN_SETUP_REPO_SHA256=""
# Optional Webmin administration-plane peer.  The bootstrap validates and
# documents these values but does not initialize Webmin or edit its internal
# cluster files; register the peer through Webmin Servers Index/Cluster UI.
WEBMIN_PEER_SERVER=
WEBMIN_PEER_IP=
WEBMIN_PEER_PORT=10000
WEBMIN_PEER_USERNAME=
WEBMIN_PEER_PASSWORD=
IPA_MIN_VCPU=2
IPA_MIN_MEMORY_MB=4096
IPA_MIN_FREE_DISK_MB=10240

# Root-owned state/log paths and the repository-relative generated record
# directory.  Do not put passwords in any of these paths.
IPA_STATE_DIR=/var/lib/freeipa-bootstrap
IPA_LOG_DIR=/var/log/freeipa-bootstrap
IPA_GENERATED_DIR=./generated
NTP_CHRONY_CONFIG_FILE=/etc/chrony.conf
